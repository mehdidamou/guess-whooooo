{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "family": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "secrets": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
